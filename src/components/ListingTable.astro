---
import { SIDES, CONFIDENCE, categoryByName } from '../lib/site';
export interface Props { listings: any[]; caption: string; filters?: boolean; }
const { listings, caption, filters = false } = Astro.props;
const cats = [...new Set(listings.map((l) => l.data.category))];
---
{filters && (
  <form class="filters" aria-label="Filter the comparison table" onsubmit="return false">
    <div>
      <label for="f-side">Built for</label>
      <select id="f-side"><option value="">Everyone</option>{Object.entries(SIDES).map(([k, v]) => <option value={k}>{v}</option>)}</select>
    </div>
    <div>
      <label for="f-cat">Category</label>
      <select id="f-cat"><option value="">All categories</option>{cats.map((c) => <option value={c}>{c}</option>)}</select>
    </div>
    <p class="small" id="f-count" aria-live="polite"></p>
  </form>
)}
<div class="table-wrap">
  <table id="compare">
    <caption>{caption}</caption>
    <thead>
      <tr><th scope="col">Tool</th><th scope="col">Built for</th><th scope="col">Entry price</th><th scope="col">Who pays</th><th scope="col">Price source</th></tr>
    </thead>
    <tbody>
      {listings.map((l) => (
        <tr data-side={l.data.side} data-cat={l.data.category}>
          <th scope="row"><a href={`/listings/${l.id}/`}>{l.data.name}</a><br /><span class="small">{categoryByName(l.data.category)?.short}</span></th>
          <td data-label="Built for">{SIDES[l.data.side]}</td>
          <td data-label="Entry price">{l.data.entryPrice}</td>
          <td data-label="Who pays">{l.data.whoPays}</td>
          <td data-label="Price source"><span class={`badge ${l.data.pricingConfidence}`}>{CONFIDENCE[l.data.pricingConfidence].label}</span></td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
{filters && (
  <script is:inline>
    (function () {
      var side = document.getElementById('f-side'), cat = document.getElementById('f-cat'), count = document.getElementById('f-count');
      var rows = Array.prototype.slice.call(document.querySelectorAll('#compare tbody tr'));
      function apply() {
        var n = 0;
        rows.forEach(function (r) {
          var show = (!side.value || r.dataset.side === side.value) && (!cat.value || r.dataset.cat === cat.value);
          r.hidden = !show; if (show) n++;
        });
        count.textContent = 'Showing ' + n + ' of ' + rows.length + ' tools';
      }
      side.addEventListener('change', apply); cat.addEventListener('change', apply); apply();
    })();
  </script>
)}
