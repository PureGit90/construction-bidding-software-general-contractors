---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ListingTable from '../components/ListingTable.astro';
import { SITE_NAME, SITE_DESCRIPTION, CATEGORIES } from '../lib/site';

const listings = (await getCollection('listings')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const site = Astro.site ?? new URL('https://example.com');
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: site.toString(), description: SITE_DESCRIPTION },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Construction bidding, takeoff and estimating software',
    numberOfItems: listings.length,
    itemListElement: listings.map((l, i) => ({ '@type': 'ListItem', position: i + 1, name: l.data.name, url: new URL(`/listings/${l.id}/`, site).toString() })),
  },
];
const countIn = (name: string) => listings.filter((l) => l.data.category === name).length;
---
<BaseLayout title={SITE_NAME} description={SITE_DESCRIPTION} jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap">
      <h1>Construction bidding software, compared by who pays.</h1>
      <p>{listings.length} bid management, takeoff and estimating tools for general contractors and subcontractors. For each one: what it costs, who actually pays, and when to skip it.</p>
      <a class="btn" href="#compare">See the comparison</a>
    </div>
  </section>
  <div class="wrap section">
    <h2>Start with what you do</h2>
    <div class="cards">
      {CATEGORIES.map((c) => (
        <div class="card">
          <a class="stretch" href={`/category/${c.slug}/`}>
            <h3>{c.name}</h3>
            <p>{c.intro.split('. ')[0]}.</p>
            <span class="count">{countIn(c.name)} tools</span>
          </a>
        </div>
      ))}
    </div>

    <h2 id="compare">All tools side by side</h2>
    <p class="lead">Pricing is the part vendors hide. Each row says where the price comes from, so you know which numbers to confirm before a call.</p>
    <ListingTable listings={listings} caption="Construction bidding, takeoff and estimating software" filters={true} />

    <div class="panel">
      <h2>The question most comparisons skip</h2>
      <p>On bid networks, someone pays and someone responds free. BuildingConnected and SmartBid charge the GC; PlanHub and ConstructConnect charge the subcontractor. Knowing which side you are on changes the whole price comparison. Read <a href="/who-pays/">who pays on each bid network</a>.</p>
    </div>
  </div>
</BaseLayout>
